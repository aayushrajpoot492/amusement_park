    };

    function showDetails(dishKey) {
        const dish = dishData[dishKey];
        if (!dish) return;

        const body = document.getElementById('drawerBody');
        body.innerHTML = `
            <img src="${dish.img}" style="width:100%; border-radius:15px; height:250px; object-fit:cover;">
            <h2 style="font-family:'Cinzel'; margin-top:20px;">${dish.name}</h2>
            <p style="color:#22c55e; font-size:24px; font-weight:bold;">${dish.price}</p>
            <div class="nutrition-row">
                <div><span class="nutri-val">${dish.calories}</span><small>Calories</small></div>
                <div><span class="nutri-val">${dish.protein}</span><small>Protein</small></div>
                <div><span class="nutri-val">${dish.fat}</span><small>Fat</small></div>
            </div>
            <p style="color:#555; text-align:left; line-height:1.6;">${dish.desc}</p>
            <button id="orderBtn" class="order-btn" onclick="handleOrder()">Order Now</button>
        `;
        document.getElementById('sidePage').style.width = "400px";
    }
    function handleOrder() {
    const btn = document.getElementById('orderBtn');

    btn.innerHTML = "✓ 1 Plate Added";

    btn.style.background = "#22c55e";
    btn.style.color = "white";

    btn.style.pointerEvents = "none";

    setTimeout(() => {
        btn.innerHTML = "Order Now";
        btn.style.background = "black";
        btn.style.pointerEvents = "auto";
    }, 2000);
}

    function closeSidePage() {
        document.getElementById('sidePage').style.width = "0";
    }
    window.addEventListener('click', function(e) {
  const sidePage = document.getElementById('sidePage');

  // Check karte hain ki kya click 'sidePage' ke bahar hua hai
  // Aur ye bhi check karte hain ki click kisi 'food-oval' par toh nahi hua (warna open hote hi band ho jayega)
  if (!sidePage.contains(e.target) && !e.target.classList.contains('food-oval')) {
    closeSidePage(); // Aapka close karne wala function call kar rahe hain
  }
});
</script>